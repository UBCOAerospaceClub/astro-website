---
import Base from "../layouts/base.astro";

---

<!-- Hero -->
<div class="relative h-screen flex items-center justify-center text-center overflow-hidden font-heading-sans">
    <img src="/hero.png"" class="absolute inset-0 w-full h-full object-cover opacity-40" />
    <div class="relative z-10">
    <h2 class="text-6xl md:text-7xl font-extrabold mb-6 animate-fade-in">Exploring Flight and Beyond</h2>
        <p class="text-2xl text-gray-200 mb-8 animate-fade-in delay-200">UAVs &#8226; Fixed-Wings &#8226; Rocketry</p>
        <a href="#join" class="px-8 py-4 bg-brand-red hover:bg-red-700 rounded-2xl font-semibold shadow-glow transition transform hover:scale-105">Join the Club</a>
    </div>
</div>

<Base title="UBCO Aerospace">

    <!-- About -->
    <section id="about" class="py-24 animate-slide-up text-center">
        <h3 class="text-4xl font-bold mb-6 font-heading-sans">About Us</h3>
    <p class="text-gray-300 leading-relaxed text-lg">We are a student-run organization at UBCO, dedicated to advancing knowledge and skills in aerospace engineering. Our club brings together passionate students to design, build, and launch UAVs and rockets.</p>

    <div class="flex flex-row gap-12 justify-center mt-12">
        <div>
            <img src="leadership-pictures/divyesh.jpg"adshot" class="mx-auto mb-4 rounded-full w-32 h-32 object-cover shadow-lg" />
            <p class="text-gray-300 mb-2 text-lg font-semibold">Divyesh</p>
            <p class="text-gray-400">President</p>
        </div>
        <div>
            <img src="leadership-pictures/ben.jpg"ot" class="mx-auto mb-4 rounded-full w-32 h-32 object-cover shadow-lg" />
            <p class="text-gray-300 mb-2 text-lg font-semibold">Ben</p>
            <p class="text-gray-400">VP Operations</p>
        </div>
        <div>
            <img src="leadership-pictures/sarthak.jpg"adshot" class="mx-auto mb-4 rounded-full w-32 h-32 object-cover shadow-lg" />
            <p class="text-gray-300 mb-2 text-lg font-semibold">Sarthak</p>
            <p class="text-gray-400">VP Finance</p>
        </div>
    </div>
    </section>


    <!-- Divisions -->
    <section id="divisions" class="py-24 animate-slide-up">
        <h3 class="text-4xl font-bold mb-6 font-heading-sans text-center">Divisions</h3>
        <div class="grid md:grid-cols-3 gap-12">
            <a href="/uav" class="relative p-8 bg-surface rounded-2xl shadow-xl transform transition hover:scale-105 hover:shadow-glow overflow-hidden">
                <img src="/uav/uav_thumb.jpg"ound" class="absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none" />
                <div class="relative z-10">
                    <h4 class="text-3xl font-semibold mb-3 font-heading-sans">UAV</h4>
                    <p class="text-gray-300">Our UAV team designs, builds, and operates unmanned aerial vehicles for competitions and research, focusing on innovation and hands-on engineering experience.</p>
                </div>
            </a>
            <a href="/rocketry" class="relative p-8 bg-surface rounded-2xl shadow-xl transform transition hover:scale-105 hover:shadow-glow overflow-hidden">
                <img src="/rocketry/rocketry_thumb.jpg"ackground" class="absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none" />
                <div class="relative z-10">
                    <h4 class="text-3xl font-semibold mb-3 font-heading-sans">Rocketry</h4>
                    <p class="text-gray-300">Dedicated to amateur rocketry projects, from small-scale launches to high-power rocketry competitions.</p>
                </div>
            </a>
            <a href="/fixed-wing" class="relative p-8 bg-surface rounded-2xl shadow-xl transform transition hover:scale-105 hover:shadow-glow overflow-hidden">
                <img src="/fixed-wing/fixed_wing_thumb.jpg" Background" class="absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none" />
                <div class="relative z-10">
                    <h4 class="text-3xl font-semibold mb-3 font-heading-sans">Fixed Wing</h4>
                    <p class="text-gray-300">Focusing on fixed-wing aircraft design and aerodynamics, this team works on innovative solutions for flight.</p>
                </div>
            </a>
        </div>
    </section>


    <!-- Sponsors -->
    <section id="sponsors" class="py-24 px-4 text-center animate-slide-up bg-white rounded-4xl">
        <h3 class="text-4xl font-bold mb-6 font-heading-sans text-background">Our Sponsors</h3>
        <p class="text-background mb-8 text-lg">We are grateful for the support of our sponsors who help make our projects possible.</p>
        <div class="flex flex-wrap justify-center gap-12 items-center mb-8">
            <img src="/sponsor-logos/Amrize.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/Cubepilot_dark.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/KFAerospace.png" class="h-16 object-contain" />
        </div>
        <div class="flex flex-wrap justify-center gap-12 items-center mb-8">
            <img src="/sponsor-logos/tmotor.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/RFDesign.jpg" class="h-16 object-contain" />
            <img src="/sponsor-logos/radxa.png" class="h-16 object-contain" />
        </div>
        <div class="flex flex-wrap justify-center gap-12 items-center">
            <img src="/sponsor-logos/ANSYS.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/AppliedIndustrialTechnologies.jpg" class="h-16 object-contain" />
            <img src="/sponsor-logos/CoastRopesAndRescue.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/CommandIndustries.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/ContrailRockets.jpg" class="h-16 object-contain" />
            <img src="/sponsor-logos/Gen3Speed.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/PiShop.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/RipstopByTheRoll.png" class="h-16 object-contain" />
            <a href="https://www.robotshop.com/"><img src="/sponsor-logos/RobotShop.jpg" class="h-16 object-contain" /></a>
            <img src="/sponsor-logos/RocketPropulsionAnalysis.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/SEEBE.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/SKYTRAC.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/SOE.png" class="h-16 object-contain" />
            <img src="/sponsor-logos/Stolairus.jpg" class="h-16 object-contain" />
            <img src="/sponsor-logos/UBCPAF.png" class="h-16 object-contain" />
        </div>
    </section>


    <!-- Join Us -->
    <section id="join" class="py-24 text-center animate-slide-up">
        <h3 class="text-4xl font-bold mb-4 font-heading-sans">Join Us</h3>
        <p class="text-gray-300 mb-8 text-lg">Interested in aerospace engineering, rocketry, or drones? We welcome students of all backgrounds and skill levels.</p>
        <a href="https://campus.hellorubric.com/?tab=memberships&s=7852" class="px-8 py-4 bg-brand-red hover:bg-red-700 rounded-2xl font-semibold shadow-glow transition transform hover:scale-105">Join the Club</a>


    </section>


    <!-- Contact -->
    <section id="contact" class="py-24 animate-slide-up text-center">
        <h3 class="text-4xl font-bold mb-6 font-heading-sans">Contact</h3>
        <a href="https://discord.gg/m75kG64EpB" class="px-8 py-4 bg-brand-red hover:bg-red-700 rounded-2xl font-semibold shadow-glow transition transform hover:scale-105">Join the Discord Server</a>
        <p class="text-gray-300 text-lg mt-5">Reach us at <a href="mailto:ubcoaerospace@gmail.com" class="text-brand-red hover:underline">ubcoaerospace@gmail.com</a></p>
        <p class="text-gray-400 mt-3">Follow us on Instagram, YouTube, and LinkedIn.</p>
    </section>
</Base>
